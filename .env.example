# All backend calls go to the uniun-inference gateway; the website never sees
# the Razorpay key secret (that lives only on the gateway).
# .env holds the production defaults; put local-dev overrides in .env.local
# (gitignored). NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_GATEWAY_URL=https://api.uniun.in
# local dev (.env.local): NEXT_PUBLIC_GATEWAY_URL=http://localhost:8081
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
